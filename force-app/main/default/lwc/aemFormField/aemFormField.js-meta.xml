<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>AEM Form Field</masterLabel>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="fieldKey" type="String" label="Field key (from AEM)" default="firstName"/>
            <property name="queryName" type="String" label="AEM persisted query" default="contact-details"/>
            <property name="required" type="Boolean" label="Required" default="false"/>
            <property name="inputType" type="String" label="Input type" datasource="text,email,tel" default="text"/>
            <property name="minLength" type="Integer" label="Minimum length"/>
            <property name="maxLength" type="Integer" label="Maximum length"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
